# App
NODE_ENV=development

# Backend
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=adivisor
DB_USER=adivisor
DB_PASSWORD=adivisor_password
DB_ROOT_PASSWORD=root_password

# JWT
JWT_SECRET=adivisor_dev_secret_change_me
JWT_EXPIRES_IN=8h
PASSWORD_RESET_EXPIRES_IN=15m
PASSWORD_RESET_OTP_EXPIRES_IN=5m

# Gmail SMTP
# Để gửi OTP về Gmail thật, điền SMTP_USER/SMTP_FROM bằng Gmail
# và SMTP_PASSWORD bằng Gmail App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=your_gmail@gmail.com

# Frontend
VITE_API_URL=http://localhost:5000/api
VITE_SPRING_BOOT_API_URL=http://localhost:8080/api  

# phpMyAdmin
PHPMYADMIN_PORT=8081

# Google OAuth2 Config (Nếu dùng)
GG_CLIENT_ID=your_google_client_id
GG_CLIENT_SECRET=your_google_client_secret
GG_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
