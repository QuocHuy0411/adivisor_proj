PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_NAME=adivisor
DB_USER=adivisor
DB_PASSWORD=adivisor_password

JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=8h
PASSWORD_RESET_EXPIRES_IN=15m
PASSWORD_RESET_OTP_EXPIRES_IN=5m

# Gmail SMTP example: use a Gmail App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=your_gmail@gmail.com

FRONTEND_URL=http://localhost:5173
